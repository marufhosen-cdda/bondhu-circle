    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "matching": "node --conditions=react-server --import tsx scripts/run-matching.ts",
    "reminders": "node --conditions=react-server --import tsx scripts/send-reminders.ts",
    "feedback": "node --conditions=react-server --import tsx scripts/request-feedback.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
