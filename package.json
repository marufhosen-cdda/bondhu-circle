    "@react-email/render": "^2.1.0",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.57.0",
